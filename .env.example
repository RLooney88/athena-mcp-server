# Athena MCP Server - Environment Configuration
# Copy this file to .env and fill in the values

# Environment: development | test | production
NODE_ENV=development

# API Configuration
# For development (uses mock data)
API_URL=http://localhost:3000
AUTH_TOKEN=your_dev_token_here

# For test environment
TEST_API_URL=http://test-api.athena.example.com
TEST_AUTH_TOKEN=your_test_token_here

# For production environment
PROD_API_URL=https://api.athena.example.com
PROD_AUTH_TOKEN=your_production_token_here

# Request timeout in milliseconds (default: 30000)
REQUEST_TIMEOUT=30000

# Logging level: debug | info | warn | error
LOG_LEVEL=debug